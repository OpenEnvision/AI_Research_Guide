[
  {
    "id": "world-model",
    "term": "World Model",
    "zh": "世界模型",
    "aliases": [
      "环境模型"
    ],
    "category": "world-model",
    "group": "预测基础",
    "kind": "term",
    "summary": "世界模型学习环境的结构与变化规律，帮助系统预测接下来可能发生的情况。",
    "detail": [
      "模型可以预测未来观测、潜在状态或奖励，决策系统据此比较行为后果或生成训练经验。它学到的是适用于某些数据和任务的预测关系；画面逼真不代表物理规律正确，也不保证能准确预测任意动作的后果。"
    ],
    "related": [
      "dynamics-model",
      "latent-dynamics",
      "imagination"
    ],
