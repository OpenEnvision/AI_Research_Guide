    ]
  },
  {
    "id": "inverse-model",
    "term": "Inverse Dynamics Model",
    "zh": "逆动力学模型",
    "aliases": [
      "Inverse Model",
      "逆向模型"
    ],
    "category": "world-model",
    "group": "预测基础",
    "kind": "term",
    "summary": "在世界模型与表征学习中，逆动力学模型由变化前后的状态或观测推断中间动作。",
    "detail": [
      "看到物体从左侧移到右侧，模型估计可能的推动动作；多个动作可能产生类似变化，因此结果可能不唯一。这与根据末端目标位姿求关节构型的逆运动学不同。在经典机器人动力学中，逆动力学还常指由指定运动求所需力矩。"
    ],
    "related": [
      "forward-model",
      "action",
      "inverse-kinematics",
      "robot-dynamics"
    ],
