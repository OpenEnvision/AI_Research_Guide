        "url": "https://arxiv.org/abs/1803.10122"
      },
      {
        "title": "Dream to Control: Learning Behaviors by Latent Imagination",
        "url": "https://arxiv.org/abs/1912.01603"
      }
    ],
    "categories": [
      "world-model"
    ]
