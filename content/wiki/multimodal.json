    ]
  },
  {
    "id": "neural-audio-codec",
    "term": "Neural Audio Codec",
    "zh": "神经音频编解码器",
    "aliases": [
      "Neural Codec"
    ],
    "category": "multimodal",
    "group": "音频表示与编解码",
    "kind": "term",
    "summary": "神经音频编解码器用可学习的编码器、量化器和解码器压缩并重建音频。",
    "detail": [
      "编码器把波形变成紧凑表示，量化器产生离散码，解码器由这些码恢复声音。码率、延迟和重建质量之间存在权衡；Codec Token 可以用作生成模型的预测目标，但编解码器本身不等同于语音识别或文本转语音系统。"
    ],
    "related": [
      "audio-token",
      "tts",
      "asr"
    ],
    "sources": [
      {
        "title": "SoundStream: An End-to-End Neural Audio Codec",
        "url": "https://arxiv.org/abs/2107.03312"
      },
      {
        "title": "High Fidelity Neural Audio Compression",
        "url": "https://arxiv.org/abs/2210.13438"
      }
    ],
