  {
    "id": "audio-token",
    "term": "Audio Token",
    "zh": "音频令牌",
    "aliases": [
      "Audio Tokens",
      "音频Token"
    ],
    "category": "multimodal",
    "group": "音频表示与编解码",
    "kind": "term",
    "summary": "音频令牌是用于序列建模的音频表示单元，可承载语义结构或声学细节。",
    "detail": [
      "离散语义令牌可从自监督音频特征量化得到；声学编解码令牌通常来自神经音频编解码器的码本。两者保留的信息和重建波形的能力不同，不能把所有音频令牌都等同于 Codec Token。"
    ],
    "related": [
      "tts",
      "asr",
      "mllm",
      "neural-audio-codec"
    ],
    "sources": [
      {
        "title": "AudioLM: a Language Modeling Approach to Audio Generation",
        "url": "https://arxiv.org/abs/2209.03143"
      }
    ],
