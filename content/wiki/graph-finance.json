  {
    "id": "look-ahead-bias",
    "term": "Look-ahead Bias",
    "zh": "前视偏差",
    "aliases": [
      "lookahead bias",
      "未来信息泄漏"
    ],
    "category": "graph-finance",
    "group": "金融建模与回测",
    "kind": "term",
    "summary": "前视偏差是在模拟历史决策时使用了当时尚不可获得的信息。",
    "detail": [
      "用月底才公布的财报决定月初买卖，就使用了未来信息。使用今天的指数成分股回测过去还可能同时引入幸存者偏差。应按每项数据实际可获得的时间构建输入，而不能只看数据所描述的日期。"
    ],
    "related": [
      "backtest",
      "data-leakage",
      "time-series",
      "survivorship-bias"
    ],
    "sources": [
      {
        "title": "QuantConnect：Understanding Time",
        "url": "https://www.quantconnect.com/docs/v1/key-concepts/understanding-time"
      },
