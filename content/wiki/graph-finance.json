    ]
  },
  {
    "id": "survivorship-bias",
    "term": "Survivorship Bias",
    "zh": "幸存者偏差",
    "aliases": [
      "Survivor Bias"
    ],
    "category": "graph-finance",
    "group": "金融建模与回测",
    "kind": "term",
    "summary": "幸存者偏差来自只观察留存下来的样本，而遗漏已经退出或失败的对象。",
    "detail": [
      "只用今天仍上市的股票回测历史，会遗漏退市或破产公司，扭曲收益与风险估计。应保留当时可用的完整样本范围及退出记录；它关注样本被如何筛选，前视偏差则关注是否用了当时不可知的信息，两者可能同时存在。"
    ],
    "related": [
      "look-ahead-bias",
      "backtest",
      "data-leakage"
    ],
    "sources": [
