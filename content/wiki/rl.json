    "id": "q-function",
    "term": "Q-function",
    "zh": "动作价值函数",
    "aliases": [
      "Q值",
      "Action Value"
    ],
    "category": "rl",
    "group": "价值与学习",
    "kind": "term",
    "summary": "动作价值函数估计在某状态先采取某个动作，再按指定策略继续行动的预期回报。",
    "detail": [
