  {
    "id": "discount-factor",
    "term": "Discount Factor",
    "zh": "折扣因子",
    "aliases": [
      "Gamma",
      "γ"
    ],
    "category": "rl",
    "group": "决策基础",
    "kind": "term",
    "summary": "折扣因子决定计算回报时，较远未来的奖励占多大权重。",
    "detail": [
      "常用定义为 G_t = R_(t+1) + γR_(t+2) + γ²R_(t+3) + …，因此执行当前动作后收到的第一项奖励不折扣。γ 通常在 0 到 1 之间；更接近 1 会保留更多远期收益，持续任务中还需考虑回报是否有限。"
    ],
    "related": [
      "return",
      "bellman-equation",
      "value-function"
    ],
    "sources": [
      {
        "title": "Spinning Up：强化学习基础",
        "url": "https://spinningup.openai.com/en/latest/spinningup/rl_intro.html"
      }
    ],
    "categories": [
      "rl"
    ]
  },
